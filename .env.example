# Deploy settings for juku-arcade. Copy to .env and fill in; .env is never committed.

# W2: daily play limit in minutes, for schools where minors play.
# Leave empty for no limit.
VITE_DAILY_CAP_MINUTES=

# D54: a private picture for the table instead of the swirl, for a local
# copy only. Put the file in public/local/ (never committed) and give its
# path under public/, for example local/table.gif (a still image or an
# animated GIF). Leave empty for any
# public build.
VITE_TABLE_IMAGE=

# Placeholder play for the streak and the play calendar: a week's streak
# ending yesterday, with a different amount played each day. It's shown,
# never saved, and labelled "sample data". A "Sample data" switch in Settings
# turns it on or off; this sets where the switch starts. Set to 1 to start
# it on; the demo bundle does (npm run demo:bundle, ops/caddy-demo.md).
# Leave it empty for a build players use for real, such as the school's.
VITE_SAMPLE_PLAY=
