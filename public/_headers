# Cloudflare Pages response headers (D20). The hosted demo's Caddy block
# (ops/demo.Caddyfile, D76) repeats this policy: change both together.
# Everything the game loads comes from this site and it sends nothing
# anywhere, so the policy allows only 'self'. Styles allow inline because
# Vue and Motion set style attributes.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# Vite puts a content hash in every asset's name, so they never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Decks keep their names between builds; an hour keeps a new build reaching players the same day.
/decks/*
  Cache-Control: public, max-age=3600
